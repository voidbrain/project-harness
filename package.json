{
  "name": "project-harness",
  "version": "4.0.0",
  "private": true,
  "license": "MIT",
  "description": "Versioned agent harness template: AGENTS, backlog, style guide, checks",
  "scripts": {
    "check:template": "node tools/check-template.mjs",
    "check:backlog": "node tools/check-backlog.mjs",
    "check:freshness": "node tools/check-freshness.mjs",
    "check:harness": "node tools/check-harness.mjs",
    "ci:status": "node tools/ci-status.mjs",
    "impact-map": "node tools/impact-map.mjs",
    "test:tools": "node --test tools/test-tools.mjs tools/test-profiles.mjs tools/test-maintenance.mjs tools/test-enforcement.mjs tools/test-audits.mjs tools/test-archive-recap.mjs tools/test-guard.mjs tools/test-rules.mjs tools/test-behaviour.mjs tools/test-browser-coverage.mjs tools/test-backlog-dependencies.mjs tools/test-backlog-queue.mjs",
    "check:integrations": "node tools/mcp.mjs check",
    "mcp:recommend": "node tools/mcp.mjs recommend",
    "reconcile:preview": "node tools/reconcile-preview.mjs",
    "friction": "node tools/friction.mjs",
    "check:maintenance": "node tools/maintenance.mjs check",
    "check:audits": "node tools/check-audits.mjs",
    "archive:recap": "node tools/archive-recap.mjs",
    "check:archive-recap": "node tools/archive-recap.mjs --check",
    "guard:install": "node tools/guard.mjs install",
    "check:rules": "node tools/check-rules.mjs",
    "behaviour": "node tools/behaviour.mjs",
    "backlog:dependencies": "node tools/backlog-dependencies.mjs",
    "check:dependencies": "node tools/backlog-dependencies.mjs --check",
    "backlog:queue": "node tools/backlog-queue.mjs",
    "check:queue": "node tools/backlog-queue.mjs --check"
  }
}
