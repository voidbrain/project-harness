{
  "template": {
    "path": "~/Projects/project-harness",
    "repo": "https://github.com/voidbrain/project-harness"
  },
  "version": "5.3.0",
  "stacks": [
    "core"
  ],
  "copied": {
    "tools/check-backlog.mjs": "core/tools/check-backlog.mjs",
    "tools/check-freshness.mjs": "core/tools/check-freshness.mjs",
    "tools/check-tooling.mjs": "core/tools/check-tooling.mjs",
    "tools/check-harness.mjs": "core/tools/check-harness.mjs",
    "tools/ci-status.mjs": "core/tools/ci-status.mjs",
    "tools/impact-map.mjs": "core/tools/impact-map.mjs",
    "tools/coverage-table.mjs": "core/tools/coverage-table.mjs",
    "tools/merge-backlog.mjs": "core/tools/merge-backlog.mjs",
    "tools/merge-when-green.mjs": "core/tools/merge-when-green.mjs",
    "tools/mcp.mjs": "core/tools/mcp.mjs",
    "tools/mcp-catalog.json": "core/tools/mcp-catalog.json",
    "docs/agents/mcp.md": "core/docs/agents/mcp.md",
    "docs/agents/solution-profile.md": "core/docs/agents/solution-profile.md",
    "tools/solution.mjs": "core/tools/solution.mjs",
    "docs/agents/skills.md": "core/docs/agents/skills.md",
    "tools/reconcile-preview.mjs": "core/tools/reconcile-preview.mjs",
    "tools/friction.mjs": "core/tools/friction.mjs",
    "docs/agents/maintenance.md": "core/docs/agents/maintenance.md",
    "tools/maintenance.mjs": "core/tools/maintenance.mjs",
    ".github/workflows/maintenance.yml": "core/.github/workflows/maintenance.yml",
    "tools/check-audits.mjs": "core/tools/check-audits.mjs",
    "docs/agents/audit.md": "core/docs/agents/audit.md",
    "tools/archive-recap.mjs": "core/tools/archive-recap.mjs",
    "tools/guard.mjs": "core/tools/guard.mjs",
    "tools/check-rules.mjs": "core/tools/check-rules.mjs",
    "docs/agents/change-impact.md": "core/docs/agents/change-impact.md",
    "tools/behaviour.mjs": "core/tools/behaviour.mjs",
    "tools/browser-coverage.mjs": "core/tools/browser-coverage.mjs",
    "tools/backlog-dependencies.mjs": "core/tools/backlog-dependencies.mjs",
    "tools/backlog-queue.mjs": "core/tools/backlog-queue.mjs",
    "tools/verification.mjs": "core/tools/verification.mjs",
    "docs/agents/verification.md": "core/docs/agents/verification.md",
    "tools/work-items.mjs": "core/tools/work-items.mjs",
    "tools/task-claims.mjs": "core/tools/task-claims.mjs",
    "docs/agents/coverage-guide.md": "core/docs/agents/coverage-guide.md",
    "docs/agents/parallel-work.md": "core/docs/agents/parallel-work.md",
    "docs/agents/architecture-review.md": "core/docs/agents/architecture-review.md",
    "docs/agents/procedures.md": "core/docs/agents/procedures.md",
    "docs/agents/task-context.md": "core/docs/agents/task-context.md",
    "tools/work-usage.mjs": "core/tools/work-usage.mjs",
    "docs/agents/work-usage.md": "core/docs/agents/work-usage.md",
    "tools/usage-launch.mjs": "core/tools/usage-launch.mjs"
  },
  "forked": {},
  "freshness": {
    "auditDays": 7
  },
  "adapted": {
    "AGENTS.md": "core/AGENTS.md",
    "CLAUDE.md": "core/CLAUDE.md",
    "README.md": "core/README.md",
    "docs/BACKLOG.md": "core/docs/BACKLOG.md",
    "docs/BACKLOG-RULES.md": "core/docs/BACKLOG-RULES.md",
    "docs/STYLE-GUIDE.md": "core/docs/STYLE-GUIDE.md",
    "docs/agents/areas.md": "core/docs/agents/areas.md",
    "docs/audits/README.md": "core/docs/audits/README.md",
    "docs/archive/README.md": "core/docs/archive/README.md",
    "GEMINI.md": "core/GEMINI.md",
    "QWEN.md": "core/QWEN.md",
    ".github/copilot-instructions.md": "core/.github/copilot-instructions.md"
  },
  "ciStatus": {
    "workflow": "CI",
    "browserJobs": "^$",
    "logNotes": []
  },
  "note": "This repository is the template and follows it: its own stamp, checked against its own release tags.",
  "impact": [
    {
      "id": "tools",
      "when": [
        "core/tools/**"
      ],
      "then": "copy core/tools/ to tools/",
      "run": "cp core/tools/*.mjs tools/",
      "checked": "check:template"
    },
    {
      "id": "release",
      "when": [
        "core/**",
        "angular/**",
        "solution/**",
        "skills/**",
        "APPLY.md"
      ],
      "then": "a CHANGELOG entry with a step for projects, VERSION and the stamps"
    },
    {
      "id": "impact-page",
      "when": [
        ".harness.json"
      ],
      "then": "regenerate the impact map page",
      "run": "node tools/impact-map.mjs",
      "checked": "CI (impact map page matches the rows)",
      "after": [
        "tools"
      ]
    },
    {
      "id": "shared-guides",
      "when": [
        "core/docs/agents/*.md"
      ],
      "then": "copy adopted shared guides to docs/agents/",
      "checked": "check:template (copied stamp entries)"
    },
    {
      "id": "archive-recaps",
      "when": [
        "docs/archive/backlog-*.md",
        "core/tools/archive-recap.mjs",
        "tools/archive-recap.mjs"
      ],
      "then": "Regenerate the weekly closure index without changing archived record lines.",
      "run": "npm run archive:recap",
      "checked": "check:archive-recap, check:backlog history guard and owned fixtures",
      "after": []
    },
    {
      "id": "behaviour",
      "when": [
        "core/AGENTS.md",
        "core/CLAUDE.md",
        "core/docs/BACKLOG-RULES.md",
        "core/tools/check-backlog.mjs",
        "core/tools/behaviour.mjs"
      ],
      "then": "rerun the agent-behaviour checks with an agent runner and compare each scenario with the last run; a regression is a backlog record",
      "run": "npm run behaviour -- run --runner=\"<agent command>\"",
      "checked": "on demand, by the owner's runner (not CI: each run costs agent time)",
      "after": []
    },
    {
      "id": "backlog-dependencies",
      "when": [
        "docs/BACKLOG.md",
        "docs/archive/backlog-*.md",
        "core/tools/backlog-dependencies.mjs"
      ],
      "then": "Regenerate linked prerequisites and reverse Unlocks without changing archived records.",
      "run": "npm run backlog:dependencies",
      "checked": "npm run check:dependencies in CI"
    },
    {
      "id": "backlog-queue",
      "when": [
        "docs/BACKLOG.md",
        "docs/archive/backlog-*.md",
        "core/tools/backlog-queue.mjs",
        "core/tools/backlog-dependencies.mjs",
        "core/docs/BACKLOG-RULES.md"
      ],
      "then": "Regenerate the read-only queue and validate ordering, prerequisites, archive compatibility and preservation of source records.",
      "run": "node tools/backlog-queue.mjs",
      "checked": "npm run check:queue; owned queue fixtures and fresh-context review"
    },
    {
      "id": "verification-policy",
      "when": [
        "core/tools/verification.mjs",
        "core/docs/agents/verification.md",
        "tools/test-verification.mjs"
      ],
      "then": "Verify scoped planning, full-run provenance and freshness boundaries with owned fixtures; reconcile adoption guidance.",
      "run": "node --test tools/test-verification.mjs",
      "checked": "No model calls or real consumer adoption required."
    },
    {
      "id": "work-items",
      "when": [
        "docs/work/**",
        "docs/agents/model-profiles.json",
        "core/tools/work-items.mjs",
        "core/tools/task-claims.mjs"
      ],
      "then": "Regenerate the source-owned backlog and validate explicit tasks, profile evidence and claim contracts.",
      "run": "node tools/work-items.mjs build && node tools/work-items.mjs check",
      "checked": "Source/view and task fixtures, normal Git CAS under archive guard, existing backlog/dependency/queue checks"
    }
  ],
  "outside": [
    {
      "what": "GitHub (gh CLI, Actions, the template clone)",
      "affects": "ci-status, the CI freshness step, release tags",
      "noticed": "the tools report an unreachable remote; the audit"
    },
    {
      "what": "MCP vendors, official registry and client configuration/discovery formats",
      "affects": "cached catalogue, setup guidance, generated snippets and skill discovery",
      "noticed": "dated source review during onboarding, relevant changes and audits; live host verification remains separate"
    },
    {
      "what": "Installed Angular/TypeScript, browser and desktop runtimes; CI action versions",
      "affects": "version-specific conventions, snippets, browser/CAD workflows and CI",
      "noticed": "locked dependency checks, own fixtures and version-specific vendor docs; real runtimes require their own acceptance"
    }
  ],
  "maintenance": {
    "enabled": true,
    "reviewDays": 7,
    "requireMeasurement": true,
    "inputs": [
      "AGENTS.md",
      "docs/BACKLOG-RULES.md",
      "docs/agents/areas.md",
      "docs/agents/maintenance.md",
      "APPLY.md",
      "core/AGENTS.md",
      "core/docs/agents/maintenance.md",
      "core/tools/friction.mjs",
      "core/tools/maintenance.mjs",
      "core/tools/coverage-table.mjs",
      "core/tools/check-freshness.mjs",
      "core/tools/check-audits.mjs",
      "core/docs/agents/audit.md",
      "core/tools/check-harness.mjs",
      "core/tools/check-rules.mjs",
      "docs/agents/mcp.md",
      "docs/agents/solution-profile.md",
      "docs/agents/skills.md",
      "docs/agents/audit.md",
      "docs/agents/change-impact.md",
      "core/tools/behaviour.mjs",
      "docs/agents/parallel-work.md",
      "docs/agents/architecture-review.md",
      "docs/agents/procedures.md",
      "tools/work-items.mjs",
      "tools/task-claims.mjs",
      "docs/agents/task-context.md",
      "core/docs/agents/task-context.md",
      "docs/agents/work-usage.md",
      "core/docs/agents/work-usage.md",
      "core/tools/work-usage.mjs",
      "tools/usage-launch.mjs"
    ]
  },
  "audit": {
    "days": 7,
    "enforce": true
  },
  "rules": {
    "agents": "AGENTS.md",
    "procedures": [
      "docs/BACKLOG-RULES.md",
      "docs/agents/*.md",
      "APPLY.md"
    ],
    "maxLines": 200
  },
  "behaviour": {
    "times": 3,
    "rules": {
      "AGENTS.md": "core/AGENTS.md",
      "CLAUDE.md": "core/CLAUDE.md",
      "docs/BACKLOG-RULES.md": "core/docs/BACKLOG-RULES.md",
      "tools/check-backlog.mjs": "core/tools/check-backlog.mjs"
    }
  },
  "verification": {
    "enabled": false
  },
  "workItems": {
    "enabled": true,
    "layout": "docs/work/layout.json",
    "records": "docs/work/records",
    "tasks": "docs/work/tasks",
    "profiles": "docs/agents/model-profiles.json",
    "featurePlans": true,
    "order": "queue"
  },
  "pages": [
    {
      "title": "Parallel Work",
      "path": "docs/agents/parallel-work.md",
      "about": "Shared optional workflow procedure"
    },
    {
      "title": "Architecture Review",
      "path": "docs/agents/architecture-review.md",
      "about": "Shared optional workflow procedure"
    },
    {
      "title": "Procedures",
      "path": "docs/agents/procedures.md",
      "about": "Shared optional workflow procedure"
    },
    {
      "title": "Task context",
      "path": "docs/agents/task-context.md",
      "about": "Optional task-boundary handoffs and host-aware context transitions"
    }
  ],
  "workUsage": {
    "enabled": true
  }
}
