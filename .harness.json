{
  "template": {
    "path": "~/Projects/project-harness",
    "repo": "https://github.com/voidbrain/project-harness"
  },
  "version": "3.0.0",
  "stacks": [
    "core"
  ],
  "copied": {
    "tools/check-backlog.mjs": "core/tools/check-backlog.mjs",
    "tools/check-freshness.mjs": "core/tools/check-freshness.mjs",
    "tools/check-harness.mjs": "core/tools/check-harness.mjs",
    "tools/ci-status.mjs": "core/tools/ci-status.mjs",
    "tools/impact-map.mjs": "core/tools/impact-map.mjs",
    "tools/coverage-table.mjs": "core/tools/coverage-table.mjs",
    "tools/merge-backlog.mjs": "core/tools/merge-backlog.mjs",
    "tools/merge-when-green.mjs": "core/tools/merge-when-green.mjs",
    "tools/mcp.mjs": "core/tools/mcp.mjs",
    "tools/mcp-catalog.json": "core/tools/mcp-catalog.json",
    "docs/agents/mcp.md": "core/docs/agents/mcp.md",
    "docs/agents/solution-profile.md": "core/docs/agents/solution-profile.md",
    "tools/solution.mjs": "core/tools/solution.mjs",
    "docs/agents/skills.md": "core/docs/agents/skills.md",
    "tools/reconcile-preview.mjs": "core/tools/reconcile-preview.mjs",
    "tools/friction.mjs": "core/tools/friction.mjs",
    "docs/agents/maintenance.md": "core/docs/agents/maintenance.md",
    "tools/maintenance.mjs": "core/tools/maintenance.mjs",
    ".github/workflows/maintenance.yml": "core/.github/workflows/maintenance.yml"
  },
  "forked": {},
  "freshness": {
    "auditDays": 7
  },
  "adapted": {
    "AGENTS.md": "core/AGENTS.md",
    "CLAUDE.md": "core/CLAUDE.md",
    "README.md": "core/README.md",
    "docs/BACKLOG.md": "core/docs/BACKLOG.md",
    "docs/BACKLOG-RULES.md": "core/docs/BACKLOG-RULES.md",
    "docs/STYLE-GUIDE.md": "core/docs/STYLE-GUIDE.md",
    "docs/agents/areas.md": "core/docs/agents/areas.md",
    "docs/audits/README.md": "core/docs/audits/README.md",
    "docs/archive/README.md": "core/docs/archive/README.md"
  },
  "ciStatus": {
    "workflow": "CI",
    "browserJobs": "^$",
    "logNotes": []
  },
  "note": "This repository is the template and follows it: its own stamp, checked against its own release tags.",
  "impact": [
    {
      "id": "tools",
      "when": [
        "core/tools/**"
      ],
      "then": "copy core/tools/ to tools/",
      "run": "cp core/tools/*.mjs tools/",
      "checked": "check:template"
    },
    {
      "id": "release",
      "when": [
        "core/**",
        "angular/**",
        "solution/**",
        "skills/**",
        "APPLY.md"
      ],
      "then": "a CHANGELOG entry with a step for projects, VERSION and the stamps"
    },
    {
      "id": "impact-page",
      "when": [
        ".harness.json"
      ],
      "then": "regenerate the impact map page",
      "run": "node tools/impact-map.mjs",
      "checked": "CI (impact map page matches the rows)",
      "after": [
        "tools"
      ]
    },
    {
      "id": "shared-guides",
      "when": [
        "core/docs/agents/*.md"
      ],
      "then": "copy adopted shared guides to docs/agents/",
      "checked": "check:template (copied stamp entries)"
    }
  ],
  "outside": [
    {
      "what": "GitHub (gh CLI, Actions, the template clone)",
      "affects": "ci-status, the CI freshness step, release tags",
      "noticed": "the tools report an unreachable remote; the audit"
    },
    {
      "what": "MCP vendors, official registry and client configuration/discovery formats",
      "affects": "cached catalogue, setup guidance, generated snippets and skill discovery",
      "noticed": "dated source review during onboarding, relevant changes and audits; live host verification remains separate"
    },
    {
      "what": "Installed Angular/TypeScript, browser and desktop runtimes; CI action versions",
      "affects": "version-specific conventions, snippets, browser/CAD workflows and CI",
      "noticed": "locked dependency checks, own fixtures and version-specific vendor docs; real runtimes require their own acceptance"
    }
  ],
  "maintenance": {
    "enabled": true,
    "reviewDays": 7,
    "requireMeasurement": true,
    "inputs": [
      "AGENTS.md",
      "docs/BACKLOG-RULES.md",
      "docs/agents/areas.md",
      "docs/agents/maintenance.md",
      "APPLY.md",
      "core/AGENTS.md",
      "core/docs/agents/maintenance.md",
      "core/tools/friction.mjs",
      "core/tools/maintenance.mjs",
      "core/tools/coverage-table.mjs",
      "core/tools/check-freshness.mjs"
    ]
  }
}
